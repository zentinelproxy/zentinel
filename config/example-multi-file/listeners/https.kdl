// TLS listener.
//
// min-version and max-version take "1.2" or "1.3" (also written "tls1.2" or
// "tlsv1.2", in any letter case); any other value is an error.

listeners {
    listener "https" {
        address "0.0.0.0:8443"
        protocol "https"

        tls {
            cert-file "/etc/zentinel/certs/example.crt"
            key-file "/etc/zentinel/certs/example.key"
            min-version "TLS1.2"
        }
    }
}
