// Multi-file configuration entry point.
//
// Zentinel expands `include` globs relative to this file, so a large
// configuration can be split by concern. Each included file contains
// ordinary top-level blocks; they are merged into one configuration.
//
// Validate the whole tree with:
//     zentinel test --config config/example-multi-file/zentinel.kdl

schema-version "1.0"

system {
    worker-threads 0  // 0 = auto-detect CPU cores
    graceful-shutdown-timeout-secs 30
}

limits {
    max-header-count 100
    max-connections 50000
}

include "listeners/*.kdl"
include "upstreams/*.kdl"
include "routes/*.kdl"
